# Google Sheets Integration
# You need to set these environment variables for the guest registration and evaluation features

# Option 1: Use full JSON credentials as a string (recommended for production)
# GOOGLE_SHEETS_CREDENTIALS='{"type": "service_account", "project_id": "your-project", ...}'

# Option 2: Use a path to the credentials file (for development)
# GOOGLE_SHEETS_CREDENTIALS_FILE=/path/to/credentials.json

# Spreadsheet IDs (found in the sheet URL)
# GUESTS_SPREADSHEET_ID=your-guests-spreadsheet-id
# EVALUATIONS_SPREADSHEET_ID=your-evaluations-spreadsheet-id

# Example:
# GUESTS_SPREADSHEET_ID=1abc...xyz
# EVALUATIONS_SPREADSHEET_ID=1def...uvw
